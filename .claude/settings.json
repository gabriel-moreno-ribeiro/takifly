{
	"permissions": {
		"deny": [
			"Read(./.env)",
			"Edit(./.env)",
			"Read(./data/**)",
			"Edit(./data/**)",
			"Read(./logs/**)",
			"Edit(./logs/**)"
		]
	},
	"hooks": {
		"PreToolUse": [
			{
				"matcher": "Bash",
				"hooks": [
					{
						"type": "command",
						"command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guarda.ts\""
					}
				]
			}
		]
	}
}
